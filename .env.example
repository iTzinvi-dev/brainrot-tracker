# ==============================================================================
# Brainrot Tracker Pro - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in your Firebase project credentials from the Firebase Console:
#      https://console.firebase.google.com/
# 3. Run the app with:
#      flutter run --dart-define-from-file=.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Android Configuration
# Found at: Firebase Console -> Project Settings -> General -> Your apps -> Android
# ------------------------------------------------------------------------------
FIREBASE_API_KEY_ANDROID=AIzaSyDummyPlaceholderKeyForBrainrotTrackerPro
FIREBASE_APP_ID_ANDROID=1:123456789012:android:abcdef0123456789abcdef
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_PROJECT_ID=brainrot-tracker-pro
FIREBASE_STORAGE_BUCKET=brainrot-tracker-pro.appspot.com

# ------------------------------------------------------------------------------
# Firebase iOS Configuration (Optional)
# Found at: Firebase Console -> Project Settings -> General -> Your apps -> iOS
# ------------------------------------------------------------------------------
FIREBASE_API_KEY_IOS=AIzaSyDummyPlaceholderKeyForBrainrotTrackerPro
FIREBASE_APP_ID_IOS=1:123456789012:ios:abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Application Feature Flags & Thresholds (Can also be overridden by Remote Config)
# ------------------------------------------------------------------------------
DEFAULT_DAILY_SWIPE_LIMIT=150
VELOCITY_SPIKE_THRESHOLD_SPM=40.0
BREATHE_SCREEN_DURATION_SECONDS=5
BANKING_AUTO_RESUME_MINUTES=15
ENABLE_OFFLINE_MOCK_FALLBACK=true
