rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: All collections are closed by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile: only the owner can read or write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily statistics: users can only read, create, update, and delete their own stats
    match /daily_stats/{statId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Leaderboards: authenticated read-only; no client writes permitted
    match /leaderboards/{boardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
